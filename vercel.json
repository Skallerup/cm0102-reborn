{
  "crons": [{ "path": "/api/digest", "schedule": "0 7 * * 1" }],
  "headers": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "cm0102-reborn.vercel.app" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(robots.txt|sitemap.xml)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
